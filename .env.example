# Cimian build configuration
# Copy this file to .env and set the values for your organization.

# Subject match for the code-signing certificate (partial match). build.ps1
# signs with the newest matching certificate that has a private key, looking in
# CurrentUser\My first, then LocalMachine\My. Leave it unset and no -Thumbprint,
# and signing is skipped.
CIMIAN_CERT_SUBJECT=YourOrganization

# To sign with one specific certificate, pass it on the command line instead:
#   .uild.ps1 -Sign -Thumbprint <thumbprint>

# Optional: keep .pdb files in the MSI payload.
# CIMIAN_MSI_KEEP_PDB=1

# Optional: MSI payload size limits in MB. Above the soft cap the build warns
# (default 250); above the hard cap it fails (default 0, meaning no hard cap).
# CIMIAN_MSI_PAYLOAD_SOFT_CAP_MB=250
# CIMIAN_MSI_PAYLOAD_HARD_CAP_MB=0
