<?xml version="1.0" encoding="utf-8"?>
<!-- ItemDetailPage.xaml - Software Item Detail View (WinUI 3) -->
<Page
    x:Class="Cimian.GUI.ManagedSoftwareCenter.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Grid Grid.Row="0" Margin="24,16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button 
                Grid.Column="0"
                Click="OnBackClick"
                AutomationProperties.Name="Go back"
                ToolTipService.ToolTip="Go back (Alt+Left)"
                VerticalAlignment="Center"
                Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>

            <TextBlock 
                x:Name="TitleText"
                Grid.Column="1"
                Text="Software Details"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center"
                Margin="16,0,0,0"/>
        </Grid>

        <!-- Main Content: full-width like Munki MSC detail (no half-page max-width) -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,24" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Banner: Icon | Title+developer | Install always far right -->
                <Grid x:Name="HeroSection" Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border 
                        Grid.Column="0" 
                        Width="96" Height="96" 
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Image 
                            Source="{Binding Item.IconImage}"
                            Width="96" Height="96"
                            Stretch="UniformToFill"/>
                    </Border>

                    <!-- Title, developer, description in banner (no separate "Description" heading — like Munki) -->
                    <StackPanel Grid.Column="1" Margin="20,0,24,0" VerticalAlignment="Center">
                        <TextBlock 
                            x:Name="DisplayNameText"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextWrapping="Wrap"/>
                        <TextBlock 
                            x:Name="DeveloperText"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0"/>
                        <TextBlock 
                            x:Name="BannerDescriptionText"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,0"
                            Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Install / Remove / Cancel — always pinned to the far right of the banner -->
                    <StackPanel 
                        x:Name="ActionPanel"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <!-- Install / Update Button -->
                        <Button
                            x:Name="InstallButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Install_Click"
                            AutomationProperties.Name="Install or update this software"
                            Visibility="Collapsed"
                            MinWidth="120"
                            Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon x:Name="InstallButtonIcon" Glyph="&#xE896;" FontSize="14"/>
                                <TextBlock x:Name="InstallButtonText" Text="Install" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Remove Button -->
                        <Button 
                            x:Name="RemoveButton"
                            Click="Remove_Click"
                            AutomationProperties.Name="Remove this software"
                            Visibility="Collapsed"
                            MinWidth="120"
                            Padding="16,8"
                            Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                <TextBlock Text="Remove" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Cancel Button -->
                        <Button 
                            x:Name="CancelButton"
                            Click="Cancel_Click"
                            AutomationProperties.Name="Cancel pending action"
                            Visibility="Collapsed"
                            MinWidth="120"
                            Padding="16,8"
                            Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                <TextBlock Text="Cancel" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Status Badge -->
                        <Border 
                            x:Name="StatusBadge"
                            CornerRadius="4"
                            Padding="12,6"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Margin="0,8,0,0">
                            <TextBlock 
                                x:Name="StatusText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Alerts only (description lives in the banner, like Munki) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                    <!-- Deadline Warning -->
                    <Border 
                        x:Name="DeadlineWarning"
                        Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE783;" FontSize="16" 
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock 
                                x:Name="DeadlineText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Dependency Info -->
                    <Border 
                        x:Name="DependencyInfo"
                        Visibility="Collapsed"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE946;" FontSize="16" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock 
                                x:Name="DependencyText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Unavailable Reason -->
                    <Border 
                        x:Name="UnavailableInfo"
                        Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" 
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock 
                                x:Name="UnavailableText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- What's New -->
                <StackPanel 
                    x:Name="WhatsNewPanel"
                    Grid.Row="2" 
                    Margin="0,0,0,24"
                    Visibility="Collapsed">
                    <TextBlock 
                        Text="What's New" 
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Margin="0,0,0,8"/>
                    <Border 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16">
                        <RichTextBlock 
                            x:Name="ReleaseNotesText"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"/>
                    </Border>
                </StackPanel>

                <!-- Screenshots Gallery -->
                <StackPanel 
                    x:Name="ScreenshotsPanel"
                    Grid.Row="3" 
                    Margin="0,0,0,24"
                    Visibility="Collapsed">
                    <TextBlock 
                        Text="Screenshots" 
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Margin="0,0,0,8"/>
                    <Border 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Grid>
                            <FlipView 
                                x:Name="ScreenshotFlipView"
                                Height="400"
                                Background="Transparent">
                                <FlipView.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" Stretch="Uniform" />
                                    </DataTemplate>
                                </FlipView.ItemTemplate>
                            </FlipView>
                            <PipsPager 
                                x:Name="ScreenshotPips"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,12"
                                NumberOfPages="0"
                                SelectedPageIndex="{Binding SelectedIndex, ElementName=ScreenshotFlipView, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Information: visible fields pack into 1 → 2 → 3 columns as the window grows.
                     Positions are assigned in code so collapsed fields (e.g. Available Update)
                     do not leave empty grid cells. -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,24">
                    <TextBlock 
                        Text="Information" 
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Margin="0,0,0,8"/>
                    <Grid x:Name="InfoGrid" SizeChanged="OnInfoGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="InfoCol0" Width="*"/>
                            <ColumnDefinition x:Name="InfoCol1" Width="0"/>
                            <ColumnDefinition x:Name="InfoCol2" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Order is the packing order used by RelayoutInfoGrid -->
                        <StackPanel x:Name="DeveloperPanel" Grid.Row="0" Grid.Column="0" Margin="0,0,16,16" Visibility="Collapsed">
                            <TextBlock Text="Developer" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="InfoDeveloperText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="InstalledVersionPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,16,16" Visibility="Collapsed">
                            <TextBlock x:Name="InstalledVersionLabel" Text="Installed Version" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="InstalledVersionText" Style="{StaticResource BodyTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel x:Name="InfoVersionPanel" Grid.Row="2" Grid.Column="0" Margin="0,0,16,16" Visibility="Collapsed">
                            <TextBlock Text="Available Update" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="InfoVersionText" Style="{StaticResource BodyTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel x:Name="InfoSizePanel" Grid.Row="3" Grid.Column="0" Margin="0,0,16,16">
                            <TextBlock Text="Download Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="InfoSizeText" Style="{StaticResource BodyTextBlockStyle}"/>
                        </StackPanel>

                        <StackPanel x:Name="InfoCategoryPanel" Grid.Row="4" Grid.Column="0" Margin="0,0,16,16">
                            <TextBlock Text="Category" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="InfoCategoryText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="RestartPanel" Grid.Row="5" Grid.Column="0" Margin="0,0,16,16" Visibility="Collapsed">
                            <TextBlock Text="Restart Required" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE777;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="Yes" Style="{StaticResource BodyTextBlockStyle}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Loading -->
        <ProgressRing 
            x:Name="LoadingIndicator"
            Grid.RowSpan="2"
            IsActive="False"
            Width="48" Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
    </Grid>
</Page>
