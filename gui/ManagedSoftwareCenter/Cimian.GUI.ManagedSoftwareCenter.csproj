<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RootNamespace>Cimian.GUI.ManagedSoftwareCenter</RootNamespace>
    <AssemblyName>Managed Software Center</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    
    <!-- Platform target must match runtime identifier -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">AnyCPU</PlatformTarget>
    
    <!-- Self-contained deployment -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    
    <!-- Version info -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>Managed Software Center</Product>
    <Company>Cimian</Company>
    <Description>Self-service software installation for managed Windows devices</Description>
    <ApplicationIcon>Assets\msc.ico</ApplicationIcon>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
  </ItemGroup>

  <!-- Opt-in, compile-time-only GUI fixture. Never enabled in release builds. -->
  <PropertyGroup Condition="'$(HubUiTest)' == 'true'">
    <DefineConstants>$(DefineConstants);HUB_UI_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HubUiTest)' == 'true'">
    <PackageReference Include="Moq" Version="4.20.72" />
    <Compile Include="../ManagedSoftwareCenter.Tests/HubUiFixture.cs" Link="HubUiFixture.cs" />
  </ItemGroup>
  <Target Name="RejectReleaseUiFixture" BeforeTargets="PrepareForBuild"
          Condition="'$(HubUiTest)' == 'true' And '$(Configuration)' != 'Debug'">
    <Error Text="HubUiTest is a simulated-install fixture and is permitted only in Debug builds." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\core\Cimian.Core.csproj" />
    <ProjectReference Include="..\..\shared\infrastructure\Cimian.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Ensure all content files are copied -->
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
